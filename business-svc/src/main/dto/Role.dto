export org.ninng.businesssvc.identity.domain.model.SysRole
    -> package org.ninng.businesssvc.identity.application.dto

input RoleCreateInput {
    name

    code

    roleType

    dataScope

    scopeDeptId

    remark
}

input RoleUpdateInput {
    id

    dynamic name?

    dynamic roleType?

    dynamic dataScope?

    dynamic scopeDeptId

    dynamic remark

    dynamic roleIdScopes? {
        id?

        flat(role) {
            id as roleId
        }

        dataId
    }
}

RoleDetailsView {
    id

    code

    roleType

    dataScope
}
